{
  "$schema": "https://opencode.ai/config.json",
  "enabled": true,
  "debug": false,
  "contextThreshold": 30000,
  "marker": "Shell strategy: ",
  "reminderText": "Non-interactive shell only. No editors (vim/nano) or pagers (less/more/man). Use documented non-interactive flags (-y, --no-edit, --no-pager). Fail fast on missing auth (sudo -n, ssh BatchMode). Prefer OpenCode tools (Read/Write/Edit) over shell text manipulation. Never pipe passwords. Use GIT_TERMINAL_PROMPT=0 for git."
}