{
  "$schema": "https://opencode.ai/config.json",
  "enabled": true,
  "debug": false,
  "contextThreshold": 20000,
  "marker": "Git safety: ",
  "reminderText": "Never run repository-mutating git commands (add, commit, push, pull, merge, rebase, reset, stash, checkout, switch, clean, tag, branch, mv, rm, restore, cherry-pick, revert) unless the user explicitly authorises that exact operation. Read-only git commands (status, log, diff, show, ls-files, remote -v) are fine. Use GIT_TERMINAL_PROMPT=0 for git HTTP operations."
}